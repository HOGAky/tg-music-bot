# ---- Telegram Bot ----
BOT_TOKEN=ваш_токен_от_BotFather

# ---- Spotify API (опционально) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Яндекс.Музыка (опционально) ----
# Токен Яндекс.Музыки (oauth) — нужен только для приватных плейлистов («Мне нравится» и т.п.);
# публичные плейлисты/альбомы работают без него
YANDEX_TOKEN=

# ---- База данных ----
DB_URL=sqlite+aiosqlite:///data/musicbot.db

# ---- Кэш ----
CACHE_DIR=data/cache
MAX_CONCURRENT_DOWNLOADS=2

# ---- Mini App (Web Player) ----
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8080
WEBAPP_URL=https://ваш-домен/app/

# ---- Webhook (для продакшена) ----
WEBHOOK_ENABLED=true
WEBHOOK_URL=https://ваш-домен
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=ваш-секрет-для-webhook

# ---- Логирование ----
LOG_LEVEL=INFO
LOG_FORMAT=text
