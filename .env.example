# ---- Telegram Bot ----
BOT_TOKEN=ваш_токен_от_BotFather

# ---- Spotify API (опционально) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Яндекс.Музыка (опционально) ----
# Токен Яндекс.Музыки (oauth) — нужен только для приватных плейлистов («Мне нравится» и т.п.);
# публичные плейлисты/альбомы работают без него
YANDEX_TOKEN=

# ---- База данных ----
DB_URL=sqlite+aiosqlite:///data/musicbot.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Нужен Docker Compose: сгенерируйте случайную hex-строку, например openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_random_64_character_hex_value

# ---- Кэш ----
CACHE_DIR=data/cache
MAX_CONCURRENT_DOWNLOADS=2
# Ротация mp3-кэша: файлы старше N дней удаляются безусловно (локально и в S3),
# оставшиеся чистятся по LRU до CACHE_MAX_SIZE_BYTES
CACHE_MAX_AGE_DAYS=30
CACHE_MAX_SIZE_BYTES=1500000000

# ---- Mini App (Web Player) ----
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8080
WEBAPP_URL=

# ---- Webhook (для продакшена) ----
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
MAX_CONCURRENT_UPDATES=64

# ---- Логирование ----
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- S3: Yandex Object Storage (кэш mp3, опционально) ----
# 1. Создайте бакет в Yandex Object Storage
# 2. Создайте сервисный аккаунт со ролью storage.uploader и статические ключи
USE_S3_STORAGE=false
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-central1
S3_CACHE_PREFIX=musicbot/
# TTL pre-signed URL в секундах
S3_URL_TTL=3600

# ---- Вторичный S3 (гео-резервирование) ----
# Если заполнить все 4 параметра, при недоступности Primary S3 операции
# автоматически переключаются на Secondary (Graceful Fallback)
S3_SECONDARY_ENDPOINT_URL=
S3_SECONDARY_BUCKET_NAME=
S3_SECONDARY_ACCESS_KEY_ID=
S3_SECONDARY_SECRET_ACCESS_KEY=

# ---- Redis (для Docker Compose включается автоматически) ----
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# ---- Мониторинг (WARNING/ERROR логи и health alerts в отдельный Telegram-бот) ----
MONITOR_BOT_TOKEN=
MONITOR_CHAT_ID=
MONITOR_INTERVAL_SECONDS=30

# ---- PostgreSQL (вместо SQLite, опционально) ----
# При DB_URL вида postgresql://... драйвер asyncpg выбирается автоматически
# DB_URL=postgresql://musicbot:пароль@localhost:6432/musicbot
